"""General bazel dependencies."""

module(
    name = "terrain_displacer",
    version = "0.0.0",
)

# Choose the most recent version available at
# https://registry.bazel.build/modules/
bazel_dep(name = "apple_support", version = "1.24.5", repo_name = "build_bazel_apple_support")
bazel_dep(name = "rules_cc", version = "0.2.14")
bazel_dep(name = "rules_foreign_cc", version = "0.15.1")
bazel_dep(name = "googletest", version = "1.17.0")
bazel_dep(name = "protobuf", version = "33.0")
bazel_dep(name = "libjpeg_turbo", version = "3.1.2")
bazel_dep(name = "simde", version = "0.8.2")
bazel_dep(name = "zlib", version = "1.3.1.bcr.7")
bazel_dep(name = "zstd", version = "1.5.7")

_ALL_CONTENT = """\
filegroup(
    name = "all_srcs",
    srcs = glob(["**"]),
    visibility = ["//visibility:public"],
)
"""

git_repository = use_repo_rule("@bazel_tools//tools/build_defs/repo:git.bzl", "git_repository")

git_repository(
    name = "libtiff_src",
    build_file_content = _ALL_CONTENT,
    remote = "https://gitlab.com/libtiff/libtiff.git",
    commit = "9923b128f448270d34a88357ba9b10e108a3eafb",
)
